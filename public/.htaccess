<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Redirect www to non-www (301 permanent)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect /index.php/ prefix URLs to clean URLs (301 permanent)
    RewriteCond %{REQUEST_URI} ^/index\.php/(.+)$
    RewriteRule ^ /%1 [R=301,L]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Product images: serve the full-size WebP copy at the ORIGINAL URL when the
    # browser supports WebP and a copy exists (created by: php artisan images:optimize-products).
    # e.g. /images/products/aquacef.png  ->  file images/products/webp/aquacef.png.webp
    # The URL never changes; browsers without WebP support get the original file.
    RewriteCond %{HTTP_ACCEPT} image/webp
    RewriteCond %{REQUEST_FILENAME} ^(.*)/images/products/[^/]+$
    RewriteCond %1/images/products/webp/$1.webp -f
    RewriteRule ^images/products/([^/]+\.(?:png|jpe?g))$ images/products/webp/$1.webp [NC,T=image/webp,L]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# WebP copies are named "file.png.webp": make sure they are sent as image/webp
<IfModule mod_mime.c>
    AddType image/webp .webp
</IfModule>

# ── GZIP Compression ──────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf font/woff font/woff2
</IfModule>

# ── Browser Caching ───────────────────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On

    # HTML — short cache (dynamic pages)
    ExpiresByType text/html                         "access plus 10 minutes"

    # CSS & JavaScript — long cache (Vite adds content hash to filenames)
    ExpiresByType text/css                          "access plus 1 year"
    ExpiresByType application/javascript            "access plus 1 year"
    ExpiresByType text/javascript                   "access plus 1 year"

    # Images
    ExpiresByType image/jpeg                        "access plus 6 months"
    ExpiresByType image/png                         "access plus 6 months"
    ExpiresByType image/gif                         "access plus 6 months"
    ExpiresByType image/webp                        "access plus 6 months"
    ExpiresByType image/svg+xml                     "access plus 6 months"
    ExpiresByType image/x-icon                      "access plus 1 year"

    # Fonts
    ExpiresByType font/ttf                          "access plus 1 year"
    ExpiresByType font/otf                          "access plus 1 year"
    ExpiresByType font/woff                         "access plus 1 year"
    ExpiresByType font/woff2                        "access plus 1 year"
    ExpiresByType application/font-woff             "access plus 1 year"

    # Manifest & service worker
    ExpiresByType application/manifest+json         "access plus 1 day"
    ExpiresByType text/cache-manifest               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # Cache-Control for hashed Vite assets (CSS/JS with content hash in URL)
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Cache images for 6 months
    <FilesMatch "\.(ico|jpg|jpeg|png|gif|webp|svg)$">
        Header set Cache-Control "public, max-age=15552000"
    </FilesMatch>
    # Same image URL can return WebP or PNG/JPG depending on the browser,
    # so tell caches (Cloudflare, browsers) to keep them separate.
    <FilesMatch "\.(jpg|jpeg|png|webp)$">
        Header merge Vary Accept
    </FilesMatch>
    # Cache fonts for 1 year
    <FilesMatch "\.(woff|woff2|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Security headers (also set by Laravel middleware, belt-and-suspenders)
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Suppress Apache server fingerprinting (PHP's X-Powered-By is removed in middleware)
    Header always unset Server
    Header always unset X-Powered-By
</IfModule>

<Files 403.shtml>
order allow,deny
allow from all
</Files>
